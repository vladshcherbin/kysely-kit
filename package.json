  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "devDependencies": {
    "@shcherbin/eslint-config-node": "^0.5.0",
    "@types/node": "^22.19.18",
    "@types/pg": "^8.20.0",
    "kysely": "^0.29.0",
    "pg": "^8.20.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
